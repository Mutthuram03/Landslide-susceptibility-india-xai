# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Tooling and test artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
logs/
*.log
tmp/
temp/

# Environment and secrets
.env
.env.*

# Build / packaging
build/
dist/
*.egg-info/

# Generated data artifacts (keep raw source data tracked separately)
DATA/interim/*
DATA/processed/*
!DATA/interim/.gitkeep
!DATA/processed/.gitkeep

# Model artifacts
models/*.pkl
models/*.joblib
models/*.onnx
models/*.h5

# Generated reports
reports/figures/*
!reports/figures/.gitkeep
